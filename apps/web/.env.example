# Copy to .env.local for local development. Never commit real values.

# Public (shipped to the browser). Safe values only.
# Sentry DSN for error tracking. Leave empty to turn error tracking off.
NEXT_PUBLIC_SENTRY_DSN=
# Set automatically by Vercel. Leave unset locally.
# NEXT_PUBLIC_VERCEL_ENV=

# Build-time secrets (Vercel and CI only). All three, or none.
# Used to upload source maps so error reports show real file names.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
